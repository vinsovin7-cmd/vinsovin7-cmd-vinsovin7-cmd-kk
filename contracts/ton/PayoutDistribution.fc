#pragma version >=0.4.0;
;; =====================================================================
;; SREMARA QUANTUM ECOSYSTEM - TON PAYOUT DISTRIBUTION SMART CONTRACT
;; Contract Address (Base64url): EQC_1X9yS8hK2l7QZ1WbNv6dErFt8s3mUp5_YjX9aBcDeF0G
;; Workchain: 0 (Basechain)
;; Logic: 80% Platform Share / 20% User Share / 0.1% Transfer Fee
;; =====================================================================

#include "stdlib.fc";

(slice, slice, int, int, int) load_dist_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),   ;; admin_address
        ds~load_msg_addr(),   ;; aggregator_contract
        ds~load_uint(16),     ;; platform_share_bps (8000 = 80%)
        ds~load_uint(16),     ;; user_share_bps     (2000 = 20%)
        ds~load_uint(16)      ;; transfer_fee_bps   (10 = 0.1%)
    );
}

() save_dist_data(slice admin, slice agg, int p_bps, int u_bps, int fee_bps) impure inline {
    set_data(begin_cell()
        .store_slice(admin)
        .store_slice(agg)
        .store_uint(p_bps, 16)
        .store_uint(u_bps, 16)
        .store_uint(fee_bps, 16)
        .end_cell());
}

const int op::execute_verified_payout = 0x8a92cb14;
const int op::update_shares = 0x3399aa11;

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender_address = cs~load_msg_addr();

    (slice admin, slice agg, int p_bps, int u_bps, int fee_bps) = load_dist_data();
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    ;; Execute micro-payout with 80/20 split & 0.1% fee
    if (op == op::execute_verified_payout) {
        ;; Sender must be admin / backend oracle or authorized multisig
        throw_unless(401, equal_slices(sender_address, admin));

        int gross_revenue_nano_usdt = in_msg_body~load_coins();
        slice user_wallet = in_msg_body~load_msg_addr();

        ;; Calculate User Share (20%): gross * 2000 / 10000
        int user_share = (gross_revenue_nano_usdt * u_bps) / 10000;
        
        ;; Calculate 0.1% Transaction fee: user_share * 10 / 10000
        int fee_amount = (user_share * fee_bps) / 10000;
        int net_user_payout = user_share - fee_amount;

        ;; Forward release instruction to AdRevenueAggregator
        var release_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(agg)
            .store_coins(60000000) ;; 0.06 TON execution gas
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0x5a12f9b1, 32) ;; op::release_payout_pool
            .store_uint(query_id, 64)
            .store_coins(net_user_payout)
            .store_slice(user_wallet)
            .end_cell();
        send_raw_message(release_msg, 1);
        return ();
    }

    throw(0xffff);
}

;; Get methods for verification
(int, int, int) get_revenue_split_parameters() method_id {
    (_, _, int p_bps, int u_bps, int fee_bps) = load_dist_data();
    return (p_bps, u_bps, fee_bps);
}
